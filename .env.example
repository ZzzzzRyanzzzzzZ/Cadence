# Copy this file to .env and fill in what you need.
# NEVER put a real key in this file — .env.example is committed to git.
# Real values belong in .env, which is gitignored.
#
# Everything here is optional — without it Cadence runs in demo mode
# (sign-in codes are printed in the console and shown in the browser).
#
# Check whatever you configure with:  npm run check-mail

# --- Sign-in email: pick ONE provider ---

# Option A — Resend (https://resend.com). Needs a domain you own.
# The default onboarding@resend.dev sender ONLY delivers to the email address on
# your own Resend account. To email anyone else you must verify a domain:
#   Resend -> Domains -> Add Domain -> add the DNS records -> wait for Verified
# then set MAIL_FROM to an address on that domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Option B — Brevo (https://brevo.com). No domain needed, 300 emails/day free.
# Verify a single sender address instead:
#   Brevo -> Senders, Domains & Dedicated IPs -> Senders -> Add a sender
#   Brevo emails that address a confirmation link; click it and you can send to anyone.
# Get the key at: Brevo -> SMTP & API -> API Keys.
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx

# Who the sign-in email comes from.
# Resend: must be on a verified domain (or onboarding@resend.dev for self-only testing).
# Brevo:  must be a confirmed sender address — a plain Gmail address is fine.
MAIL_FROM=Cadence <onboarding@resend.dev>

# --- Sessions ---
# Any long random string. Without it, sessions reset on every restart.
SESSION_SECRET=change-me-to-something-long-and-random

# --- Optional: plain-language weekly summary (Featherless AI) ---
# FEATHERLESS_API_KEY=
# FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# --- Optional ---
# PORT=3000
# DATA_DIR=./.data
